from pyspark.sql.types import StructType, StructField, StringType, IntegerType
import json
import os

# Create a sample JSON file with both valid and corrupt records
sample_data = [
    '{"name": "John", "age": 30, "city": "New York"}',  # Valid record
    '{"name": "Jane", "age": 25, "city": "Boston"}',   # Valid record
    '{"name": "Bob", "age": "invalid_age", "city": "Chicago"}',  # Invalid age type
    '{"name": "Alice", "age": 35}',  # Missing city field
    '{"name": "Charlie", "age": 40, "city": "Seattle", "extra_field": "should_not_be_here"}',  # Extra field
    '{"invalid_json": missing_quotes}',  # Invalid JSON syntax
    '{"name": "David", "city": "Miami"}',  # Missing age field
]

# Write sample data to a JSON file
with open('test_data.json', 'w') as f:
    for line in sample_data:
        f.write(line + '\n')

